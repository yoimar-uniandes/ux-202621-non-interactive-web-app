{
  "name": "fakto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "npm run build && vite preview --host 0.0.0.0",
    "docker:build": "docker build --tag fakto-web:local .",
    "docker:run": "docker run --rm --publish 8080:80 fakto-web:local",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "vue": "~3.5.42",
    "vue-router": "~5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@tailwindcss/vite": "~4.3.3",
    "@vitejs/plugin-vue": "~6.0.8",
    "eslint": "~10.9.1",
    "eslint-plugin-vue": "~10.8.0",
    "prettier": "~3.9.6",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.67.0",
    "vite": "~8.3.0",
    "vue-tsc": "~3.3.11"
  }
}
